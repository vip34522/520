<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/iv_hero_bg"
        android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="bottom"
        android:paddingHorizontal="20dp" android:paddingBottom="20dp" android:weightSum="2">
        <TextView android:id="@+id/btn_mark_start" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/btn_mark_end" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="10dp"/>
    </LinearLayout>
</FrameLayout>
